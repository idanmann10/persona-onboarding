DATABASE_URL=postgres://localhost/persona_dev
APP_BASE_URL=http://localhost:3000

# Sign in with Google (required before chat). A Google Cloud OAuth client of type "Web application" with
# the authorized redirect URI $APP_BASE_URL/api/auth/google/callback. Scopes: openid email profile only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local end-to-end tests only: `on` enables GET /api/auth/test-login (a fake user, no Google) under
# `next dev` on localhost. Ignored in production builds.
E2E_TEST_LOGIN=

# Text brain. Replies think at medium effort by default (none, low, medium, high); subagents use low.
# The call's tool brain has its own setting, low by default so the caller isn't kept waiting.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_VOICE_REASONING_EFFORT=low

# Browser calls use GPT-Live (gpt-live-1). Voice defaults to marin. The call's backend defaults to
# gpt-6-luna; set OPENAI_VOICE_DELEGATION=off to run calls without backend tools.
OPENAI_VOICE=marin
OPENAI_VOICE_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE_DELEGATION=on

# Optional public research. Exa finds who someone is: at sign-in from a verified work email (name + company)
# or a personal email's handle (name + handle), and later from a name and company they state. Only a single
# confident match counts; Context.dev Answers (fast mode, 10 credits) then researches a stated match.
EXA_API_KEY=
CONTEXT_DEV_API_KEY=

# Optional Gmail and Calendar via Composio managed OAuth; one auth config per toolkit.
COMPOSIO_API_KEY=
COMPOSIO_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=

# Hosting. CRON_SECRET authorizes the scheduler calling /api/automations/run-due every 5 minutes
# (ops/railway-cron on Railway);
# IP_HASH_SALT salts the hashed client addresses used for per-network limits.
CRON_SECRET=
IP_HASH_SALT=
# Bearer token for GET /api/admin/funnel (16+ characters). Leave empty to disable the endpoint.
ADMIN_SECRET=
