DATABASE_URL=postgres://localhost/persona_dev
APP_BASE_URL=http://localhost:3000

# Text brain and the backend behind voice calls. Reasoning effort: low (default), none, medium, high.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Browser calls use GPT-Live (gpt-live-1). Voice defaults to marin. The call's backend defaults to
# gpt-6-luna; set OPENAI_VOICE_DELEGATION=off to run calls without backend tools.
OPENAI_VOICE=marin
OPENAI_VOICE_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE_DELEGATION=on

# Optional public research after a confident identity match.
CONTEXT_DEV_API_KEY=

# Optional Gmail and Calendar via Composio managed OAuth; one auth config per toolkit.
COMPOSIO_API_KEY=
COMPOSIO_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=

# Hosting. CRON_SECRET authorizes a scheduler calling /api/automations/run-due (e.g. Vercel Cron);
# IP_HASH_SALT salts the hashed client addresses used for per-network limits.
CRON_SECRET=
IP_HASH_SALT=
